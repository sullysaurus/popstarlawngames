x,4.4vw,68px);line-height:.84;text-transform:uppercase}.level-count{display:flex;align-items:end;gap:10px;margin:28px 0 15px;font:400 clamp(70px,8vw,120px)/.72 var(--danger-display)}.level-count small{padding-bottom:9px;font:800 10px var(--danger-mono);letter-spacing:.12em;text-transform:uppercase}.danger-level ul{margin:12px 0 38px;padding:0;list-style:none;border-top:1px solid currentColor}.danger-level li{padding:11px 0;border-bottom:1px solid currentColor;font-size:11px}.danger-level footer{display:flex;align-items:center;justify-content:space-between;margin-top:auto}.danger-level footer strong{font:400 38px var(--danger-display)}.danger-level footer a{width:48px;height:48px;display:grid;place-items:center;border:var(--danger-line);background:var(--danger-orange);color:var(--danger-ink);font-size:22px;text-decoration:none}.most-dangerous{position:absolute;right:-8px;top:18px;padding:6px 10px;border:var(--danger-line);background:var(--danger-ink);color:var(--danger-white);font-size:8px;font-weight:800;text-transform:uppercase;transform:rotate(3deg)}.safety-copy{max-width:800px;margin:38px 0 0;font-size:10px;font-weight:700}.danger-manifesto{display:grid;grid-template-columns:.75fr 1.25fr;background:var(--danger-ink);color:var(--danger-white);border-bottom:var(--danger-line)}.manifesto-code{min-height:760px;padding:60px;display:flex;flex-direction:column;justify-content:center;align-items:center;background:repeating-linear-gradient(135deg,var(--danger-acid) 0 40px,var(--danger-ink) 40px 80px);color:var(--danger-ink);border-right:2px solid var(--danger-white)}.manifesto-code span,.manifesto-code strong,.manifesto-code small{display:block;padding:10px 18px;background:var(--danger-bone)}.manifesto-code span{font:400 90px/.8 var(--danger-display)}.manifesto-code strong{margin-top:7px;font:400 180px/.7 var(--danger-display)}.manifesto-code small{margin-top:28px;font-size:10px;font-weight:800}.manifesto-copy{padding:clamp(70px,9vw,140px) 7vw}.manifesto-copy ol{margin:50px 0 0;padding:0;list-style:none;border-top:1px solid rgba(255,255,255,.35)}.manifesto-copy li{display:grid;grid-template-columns:50px 1fr;gap:20px;padding:25px 0;border-bottom:1px solid rgba(255,255,255,.35)}.manifesto-copy li>span{font-size:11px;color:var(--danger-acid)}.manifesto-copy li strong{font-family:var(--danger-display);font-size:24px;font-weight:400;text-transform:uppercase}.manifesto-copy li p{max-width:580px;margin:8px 0 0;color:#bdb8ae}.danger-cta{padding:clamp(90px,13vw,200px) 5vw;text-align:center;background:var(--danger-acid)}.danger-cta h2{max-width:1200px;margin-inline:auto}.danger-cta .hazard-button{margin-top:48px}.hazard-button-invert{background:var(--danger-ink);color:var(--danger-white);box-shadow:7px 7px 0 var(--danger-orange)}.danger-cta>p:last-child{margin-top:28px;font-size:11px;font-weight:800;text-transform:uppercase}.danger-footer{min-height:120px;padding:25px 4vw;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:30px;background:var(--danger-bone);border-top:var(--danger-line)}.danger-footer p{font-size:10px;font-weight:700;text-align:center}.danger-footer>a:last-child{justify-self:end;font-size:10px;font-weight:800;text-underline-offset:5px}@keyframes danger-scroll{to{transform:translateX(-50%)}}@media(max-width:980px){.danger-nav{grid-template-columns:1fr auto}.danger-nav nav{display:none}.danger-hero,.danger-evidence,.danger-manifesto{grid-template-columns:1fr}.danger-hero-field{min-height:650px}.danger-level-grid{grid-template-columns:1fr}.level-two{transform:none}.danger-section-heading{grid-template-columns:1fr}.manifesto-code{display:none}.danger-footer{grid-template-columns:1fr;text-align:center}.danger-footer .danger-logo{justify-self:center}.danger-footer>a:last-child{justify-self:center}}@media(max-width:620px){.hazard-rail{justify-content:flex-start}.hazard-rail span:nth-child(n+3){display:none}.danger-nav{min-height:78px;padding:12px 14px;gap:10px}.danger-logo{font-size:12px}.danger-logo-mark{width:40px;height:40px;font-size:20px}.danger-nav>.hazard-button{padding:9px 11px;font-size:8px;gap:8px}.danger-hero{min-height:auto}.danger-hero-copy{padding:70px 18px}.danger-hero h1{font-size:clamp(58px,19vw,88px)}.danger-deck{font-size:15px}.danger-actions{align-items:stretch;flex-direction:column}.danger-actions .underlined-link{text-align:center}.fine-warning{margin-top:30px}.danger-hero-field{min-height:500px}.danger-stamp{width:125px}.danger-stamp strong{font-size:34px}.warning-card{left:14px;right:14px;bottom:18px}.danger-ticker span{font-size:20px}.danger-evidence,.danger-packages{padding:75px 18px}.evidence-intro h2,.danger-section-heading h2,.manifesto-copy h2,.danger-cta h2{font-size:clamp(46px,15vw,72px)}.side-effects{margin-top:45px}.danger-section-heading{margin-bottom:35px}.danger-level{padding:22px}.danger-level h3{font-size:49px}.most-dangerous{right:-3px}.manifesto-copy{padding:80px 18px}.manifesto-copy li{grid-template-columns:34px 1fr}.danger-cta{padding:100px 18px}.danger-footer{padding:35px 18px}}@media(prefers-reduced-motion:reduce){.danger-ticker div{animation:none}.hazard-button{transition:none}}
</style>

<style is:global>
  .danger-product-shot {
    position: relative;
    width: calc(100% + 50px);
    aspect-ratio: 4 / 3;
    margin: -25px -25px 26px;
    overflow: hidden;
    border-bottom: var(--danger-line);
    background: var(--danger-ink);
  }

  .danger-product-shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(.9) contrast(1.05);
    transition: transform 500ms cubic-bezier(.23, 1, .32, 1);
  }

  .danger-level:hover .danger-product-shot img { transform: scale(1.025); }

  .danger-product-shot figcaption {
    position: absolute;
    left: 10px;
    bottom: 10px;
    margin: 0;
    padding: 6px 9px;
    border: 1px solid var(--danger-ink);
    background: var(--danger-acid);
    color: var(--danger-ink);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .danger-stamp {
    right: auto !important;
    left: 5%;
    top: 5%;
  }

  .danger-hero h1 { font-size: clamp(64px, 7vw, 112px) !important; }

  @media (max-width: 980px) {
    .danger-hero,
    .danger-evidence,
    .danger-manifesto,
    .danger-section-heading,
    .danger-level-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .danger-hero > *,
    .danger-evidence > *,
    .danger-manifesto > *,
    .danger-section-heading > *,
    .danger-level-grid > *,
    .side-effects article > * {
      min-width: 0;
    }
  }

  @media (max-width: 620px) {
    .danger-site h1,
    .danger-site h2,
    .danger-site h3 { font-family: Impact, "Arial Narrow", sans-serif !important; letter-spacing: -.025em; }
    .danger-hero h1 { font-size: clamp(36px, 11vw, 48px) !important; }
    .evidence-intro h2,
    .danger-section-heading h2,
    .manifesto-copy h2,
    .danger-cta h2 { font-size: clamp(29px, 9vw, 40px) !important; }
