---
import "../styles/global.css";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import AvailabilityForm from "../components/AvailabilityForm.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <GoogleAnalytics />
    <meta
      name="description"
      content="Premium lawn game rentals delivered, styled, and picked up for weddings, company events, and parties across Raleigh and the Triangle."
    />
    <title>Premium Lawn Game Rentals in Raleigh | Popstar Lawn Games</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ff5d47" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,700;9..144,900&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="/script.js" defer></script>
  </head>
  <body>
    <div class="announcement">
      <p>Now booking the Triangle</p>
      <a href="/rentals/">Request your date <span aria-hidden="true">↗</span></a>
    </div>

    <header class="site-header">
      <a class="brand" href="#top" aria-label="Popstar Lawn Games home">
        <span class="brand-mark" aria-hidden="true"><img src="/assets/popstar-mark.png" alt="" /></span>
        <span>Popstar<br />Lawn Games</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#packages">Packages</a>
        <a href="/rentals/">Request availability</a>
        <a href="#occasions">Occasions</a>
        <a href="#how-it-works">How it works</a>
        <a href="/blog/">Playbook</a>
      </nav>
      <a class="button button-small button-dark" href="/rentals/">Check availability</a>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-copy reveal">
          <p class="eyebrow">Premium lawn game rentals · Raleigh &amp; the Triangle</p>
          <h1>Make room for a <em>really</em> good time.</h1>
          <p class="hero-deck">
            Design-forward lawn games that arrive ready to play—so your guests
            mingle, laugh, and stay a little longer.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="/rentals/">Check your date</a>
            <a class="text-link" href="#games">See every game <span aria-hidden="true">↓</span></a>
          </div>
          <div class="proof-row" aria-label="Service benefits">
            <span>★★★★★ 5-star service</span>
            <span>Delivery + setup</span>
            <span>Fully insured</span>
          </div>
        </div>

        <div class="hero-stage photo-stage reveal reveal-delay" aria-label="Guests enjoying premium lawn games at an outdoor wedding">
          <video class="ambient-video" autoplay muted loop playsinline aria-hidden="true">
            <source data-src="assets/hero-party-loop.mp4" type="video/mp4" />
          </video>
          <img class="hero-photo" src="/assets/hero-party-reference.jpg" alt="Wedding guests playing cornhole, a giant tumbling tower and four-in-a-row on an estate lawn" width="1586" height="992" fetchpriority="high" />
          <div class="hero-sticker" aria-hidden="true">Play<br />outside<br />the box!</div>
          <div class="spark spark-one" aria-hidden="true">✦</div>
          <div class="spark spark-two" aria-hidden="true">✦</div>
        </div>
      </section>

      <section class="availability-wrap" id="availability">
        <div class="availability-intro">
          <p class="eyebrow">Start with the fun part</p>
          <h2>Choose what you like. We’ll check the date.</h2>
          <p>Tell us about your event, pick a starting package, and flag any must-have games. We’ll reply with availability and a complete quote.</p>
        </div>
        <AvailabilityForm heading="Check your date." />
      </section>

      <section class="packages section" id="packages">
        <div class="section-heading">
          <div>
            <p class="eyebrow">The opening lineup</p>
            <h2>Pick your kind of fun.</h2>
          </div>
          <p>
            Choose a ready-made game mix that keeps delivery worthwhile and planning simple.
            Delivery and setup are handled separately based on your venue.
          </p>
        </div>

        <div class="package-grid">
          <article class="package-card package-yellow reveal-card">
            <div class="package-number">01</div>
            <div class="package-art art-social" aria-hidden="true">
              <video class="ambient-video" autoplay muted loop playsinline>
                <source data-src="assets/social-set-loop.mp4" type="video/mp4" />
              </video>
              <img class="package-photo" src="/assets/social-set-reference.jpg" alt="" width="1454" height="1091" loading="lazy" />
            </div>
            <div class="package-content">
              <p class="package-kicker">The easy crowd-pleaser</p>
              <h3>The Social Set</h3>
              <p>Cornhole, giant tower and four-in-a-row. Three classics, zero awkward mingling.</p>
              <ul>
                <li>Cornhole, giant tower + four-in-a-row</li>
                <li>Event-day game rental</li>
                <li>Delivery + setup available</li>
              </ul>
              <div class="package-footer">
                <p><small>Games</small><strong>$200</strong></p>
                <a class="circle-button" href="/rentals/#availability-form" aria-label="Request availability for The Social Set">↗</a>
              </div>
            </div>
          </article>

          <article class="package-card package-coral reveal-card">
            <div class="popular-tag">Most popular</div>
            <div class="package-number">02</div>
            <div class="package-art art-celebration" aria-hidden="true">
              <video class="ambient-video" autoplay muted loop playsinline>
                <source data-src="assets/celebration-set-loop.mp4" type="video/mp4" />
              </video>
              <img class="package-photo" src="/assets/celebration-set-reference.jpg" alt="" width="1454" height="1091" loading="lazy" />
            </div>
            <div class="package-content">
              <p class="package-kicker">More games, more staying power</p>
              <h3>The Celebration Set</h3>
              <p>A five-game lineup built for cocktail hours, company parties and big backyards.</p>
              <ul>
                <li>Cornhole, giant tower + four-in-a-row</li>
                <li>Putterball + ring toss</li>
                <li>Delivery + setup available</li>
              </ul>
              <div class="package-footer">
                <p><small>Games</small><strong>$325</strong></p>
                <a class="circle-button" href="/rentals/#availability-form" aria-label="Request availability for The Celebration Set">↗</a>
              </div>
            </div>
          </article>

          <article class="package-card package-blue reveal-card">
            <div class="package-number">03</div>
            <div class="package-art art-headliner" aria-hidden="true">
              <video class="ambient-video" autoplay muted loop playsinline>
                <source data-src="assets/headliner-loop.mp4" type="video/mp4" />
              </video>
              <img class="package-photo" src="/assets/headliner-reference.jpg" alt="" width="1448" height="1086" loading="lazy" />
            </div>
            <div class="package-content">
              <p class="package-kicker">The whole lawn, handled</p>
              <h3>The Headliner</h3>
              <p>Our biggest styled game collection for weddings, fundraisers and full-scale celebrations.</p>
              <ul>
                <li>All 6 games in the current collection</li>
                <li>Event-day game rental</li>
                <li>Delivery + priority setup available</li>
              </ul>
              <div class="package-footer">
                <p><small>Games</small><strong>$395</strong></p>
                <a class="circle-button" href="/rentals/#availability-form" aria-label="Request availability for The Headliner">↗</a>
              </div>
            </div>
          </article>
        </div>
        <aside class="capacity-upgrade">
          <div>
            <p class="eyebrow">For bigger guest lists</p>
            <h3>The Large Event Set</h3>
            <p>
              Ten or more simultaneous play stations, built around extra cornhole,
              giant towers and four-in-a-row so a crowd keeps moving.
            </p>
          </div>
          <p class="capacity-price"><small>Games from</small><strong>$450</strong></p>
          <a
            class="button button-dark"
            href="#availability-form"
          >Plan the large-event mix</a>
        </aside>
        <p class="package-note">
          Package prices shown are the current game totals. Delivery, setup, after-midnight pickup,
          and next-day pickup vary by venue and timing.
          Need a hosted company tournament or field day? Custom event production starts at $2,500.
        </p>
      </section>

      <section class="marquee" aria-label="Available games">
        <div>
          <span>Cornhole</span><i>✦</i><span>Giant Tower</span><i>✦</i><span>Four-in-a-Row</span><i>✦</i>
          <span>Putterball</span><i>✦</i><span>Ring Toss</span><i>✦</i><span>Yard Dice</span><i>✦</i>
        </div>
      </section>

      <section class="games section" id="games" aria-labelledby="games-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">The current game collection</p>
            <h2 id="games-title">See what’s ready to play.</h2>
          </div>
          <p>
            Six guest-friendly games, selected for easy drop-in play. Every package combines
            these favorites into an easy-to-request lineup.
          </p>
        </div>
        <div class="game-grid">
          <article class="game-card game-card-yellow">
            <img src="/assets/games/cornhole.jpg" alt="Representative cornhole rental set arranged on an event lawn" width="1200" height="1200" loading="lazy" />
            <span class="game-number">01</span>
            <h3>Cornhole</h3>
            <p>The two-board bag toss classic that works for nearly every crowd.</p>
          </article>
          <article class="game-card game-card-coral">
            <img src="/assets/games/giant-tower.jpg" alt="Representative giant tumbling tower arranged on an event lawn" width="1200" height="1200" loading="lazy" />
            <span class="game-number">02</span>
            <h3>Giant Tower</h3>
            <p>Oversized stacking, steady hands, and a finale everyone stops to watch.</p>
          </article>
          <article class="game-card game-card-blue">
            <img src="/assets/games/four-in-a-row.jpg" alt="Representative giant four-in-a-row game arranged on an event lawn" width="1200" height="1200" loading="lazy" />
            <span class="game-number">03</span>
            <h3>Four-in-a-Row</h3>
            <p>Fast, familiar two-player strategy in a much more photogenic format.</p>
          </article>
          <article class="game-card game-card-cream">
            <img src="/assets/games/putterball.jpg" alt="Representative portable putting game arranged on an event lawn" width="1200" height="1200" loading="lazy" />
            <span class="game-number">04</span>
            <h3>Putterball</h3>
            <p>A putting challenge that gives golfers and first-timers an equal shot.</p>
          </article>
          <article class="game-card game-card-yellow">
            <img src="/assets/games/ring-toss.jpg" alt="Representative wooden ring toss game arranged on an event lawn" width="1200" height="1200" loading="lazy" />
            <span class="game-number">05</span>
            <h3>Ring Toss</h3>
            <p>A compact, quick-play classic for patios, lawns, and smaller spaces.</p>
          </article>
          <article class="game-card game-card-coral">
            <img src="/assets/games/yard-dice.jpg" alt="Representative oversized wooden yard dice arranged on an event lawn" width="1200" height="1200" loading="lazy" />
            <span class="game-number">06</span>
            <h3>Yard Dice</h3>
            <p>Oversized dice for casual rounds, team play, and all-ages competition.</p>
          </article>
        </div>
        <p class="catalog-photo-note">Representative catalog photography; the finish and color of the delivered games may vary.</p>
        <div class="games-footer">
          <p>Not sure what fits your event?</p>
          <div class="games-footer-actions">
            <a class="button button-primary" href="#availability-form">Check your date</a>
            <a class="button button-dark" href="#availability-form">Ask for a recommendation</a>
          </div>
        </div>
      </section>

      <section class="occasions section" id="occasions">
        <div class="occasion-copy">
          <p class="eyebrow">Good at almost everything</p>
          <h2>One rental.<br /><em>Instant chemistry.</em></h2>
          <p>
            Games give guests something to do with their hands and a reason to meet. That makes
            them just as useful at a polished brand activation as a backyard birthday.
          </p>
          <a class="button button-dark" href="#availability-form">Request availability</a>
        </div>
        <div class="occasion-list">
          <article><span>01</span><h3>Weddings</h3><p>Cocktail hours that actually mix.</p></article>
          <article><span>02</span><h3>Company parties</h3><p>Team building without the trust falls.</p></article>
          <article><span>03</span><h3>Schools &amp; universities</h3><p>Big energy for students of every age.</p></article>
          <article><span>04</span><h3>Backyard celebrations</h3><p>Your lawn’s greatest performance yet.</p></article>
        </div>
      </section>

      <section class="process section" id="how-it-works">
        <div class="section-heading">
          <div><p class="eyebrow">Easy does it</p><h2>We bring the play.</h2></div>
          <p>You bring the people. Everything else happens in three refreshingly simple steps.</p>
        </div>
        <ol class="process-grid">
          <li><span>1</span><h3>Share your date</h3><p>Tell us when, where, and what kind of event you’re planning.</p></li>
          <li><span>2</span><h3>Pick your favorites</h3><p>Choose a package, individual games, or ask us to recommend the mix.</p></li>
          <li><span>3</span><h3>Confirm the plan</h3><p>We check availability and send the complete quote before you book.</p></li>
        </ol>
      </section>

      <section class="journal-preview section" aria-labelledby="journal-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">The Popstar Playbook</p>
            <h2 id="journal-title">Plan a party people play in.</h2>
          </div>
          <p>Practical guides for choosing games, laying out your space, and keeping every kind of guest in the mix.</p>
        </div>
        <div class="journal-preview-grid">
          <a class="journal-feature" href="/blog/best-yard-games-for-parties/">
            <img src="/assets/social-set-reference.jpg" alt="Premium giant lawn games arranged for an outdoor party" width="1454" height="1091" loading="lazy" />
            <div><span>Party planning</span><h3>11 yard games that guests actually want to play</h3><p>Match the right games to your crowd, space, and event style.</p></div>
          </a>
          <div class="journal-links">
            <a href="/blog/wedding-lawn-games-guide/"><span>Weddings</span><h3>The complete guide to wedding lawn games</h3><b aria-hidden="true">↗</b></a>
            <a href="/blog/corporate-event-lawn-games/"><span>Company events</span><h3>How to plan lawn games without forced fun</h3><b aria-hidden="true">↗</b></a>
            <a class="button button-dark" href="/blog/">Read the Playbook</a>
          </div>
        </div>
      </section>

      <section class="final-cta">
        <p class="eyebrow">Your date won’t plan itself</p>
        <h2>Let’s make it a<br /><em>play date.</em></h2>
        <a class="button button-accent" href="#availability-form">Request your date</a>
        <div class="cta-star" aria-hidden="true">★</div>
      </section>
    </main>

    <footer>
      <a class="brand brand-footer" href="#top">
        <span class="brand-mark" aria-hidden="true"><img src="/assets/popstar-mark.png" alt="" /></span>
        <span>Popstar<br />Lawn Games</span>
      </a>
      <p>Curated event rentals for Raleigh, Durham, Chapel Hill and the surrounding Triangle.</p>
      <div class="footer-links">
        <a href="#availability-form">Check availability</a>
        <a href="/rentals/">Request a package</a>
        <a href="/blog/">The Playbook</a>
        <a href="#availability-form">Start your request</a>
      </div>
      <p class="copyright">© <span id="year"></span> Popstar Lawn Games</p>
    </footer>

  </body>
</html>
