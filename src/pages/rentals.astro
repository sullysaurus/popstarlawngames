---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout
  title="Book Lawn Game Rentals in Raleigh | Popstar Lawn Games"
  description="Check dates, prices, and availability for cornhole, giant tower, four-in-a-row, Putterball, ring toss, and yard dice rentals across Raleigh and the Triangle."
>
  <SiteHeader />

  <main>
    <section class="rental-hero">
      <div>
        <p class="eyebrow">Direct online booking</p>
        <h1>Pick a date.<br /><em>Bring the play.</em></h1>
      </div>
      <div class="rental-hero-copy">
        <p>
          Choose your event dates, add an available package to your cart, and complete checkout
          without waiting for a quote. Need an unusual layout or a larger styled event? We can help.
        </p>
        <a class="text-link" href="/#custom-inquiry">Get help with a custom event <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="booking-shell" aria-labelledby="booking-title">
      <div class="booking-intro">
        <p class="eyebrow">Live inventory</p>
        <h2 id="booking-title">Book in three steps.</h2>
        <p>1. Select your rental period. 2. Choose a package. 3. Open your cart and check out.</p>
      </div>

      <div class="booqable-catalog">
        <div class="booqable-product-list"></div>
      </div>

      <aside class="booking-note">
        <strong>A quick heads-up:</strong>
        <span>
          The prices shown cover the games. Delivery, setup, and pickup details depend on your
          venue; we’ll confirm those logistics by email after your online reservation.
        </span>
      </aside>
    </section>

    <section class="rental-concierge">
      <div>
        <p class="eyebrow">Want the whole lawn handled?</p>
        <h2>Need a custom setup?</h2>
      </div>
      <p>
        Our Large Event Set starts at $450 for 10 or more play stations. Tell us about the crowd and
        venue, and we’ll build the right high-capacity mix.
      </p>
      <a class="button button-accent" href="/#custom-inquiry">Tell us about the event</a>
    </section>
  </main>

  <SiteFooter />
  <script is:inline src="https://4f058e46-ebd1-45b7-90bb-12c7cb19e4d4.assets.booqable.com/v2/booqable.js"></script>
</BaseLayout>
