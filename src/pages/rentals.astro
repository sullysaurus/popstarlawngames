---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AvailabilityForm from "../components/AvailabilityForm.astro";
---

<BaseLayout
  title="Check Lawn Game Rental Availability in Raleigh | Popstar Lawn Games"
  description="Request availability for cornhole, giant tower, four-in-a-row, Putterball, ring toss, and yard dice rentals across Raleigh and the Triangle."
>
  <SiteHeader />

  <main>
    <section class="rental-hero">
      <div>
        <p class="eyebrow">Start with your wish list</p>
        <h1>Pick the fun.<br /><em>We’ll check the date.</em></h1>
      </div>
      <div class="rental-hero-copy">
        <p>
          Choose a package or the games you have in mind. We’ll confirm what is available for your
          event and send a complete quote before you make any commitment.
        </p>
        <a class="text-link" href="#availability-form">Request availability <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <section class="booking-shell" aria-labelledby="booking-title">
      <div class="booking-intro">
        <p class="eyebrow">Availability request</p>
        <h2 id="booking-title">What would you like to play?</h2>
        <p>Pick a starting package and any favorite games. We’ll check the date, make sure the mix fits your event, and reply with next steps.</p>
      </div>

      <AvailabilityForm heading="Build your wish list." />

      <aside class="booking-note">
        <strong>Good to know:</strong>
        <span>
          Sending this form does not hold inventory or charge you. We’ll confirm the games,
          delivery, setup, pickup, and full price with you first.
        </span>
      </aside>
    </section>

    <section class="rental-concierge">
      <div>
        <p class="eyebrow">Want the whole lawn handled?</p>
        <h2>Need a custom setup?</h2>
      </div>
      <p>
        Our Large Event Set starts at $450 for 10 or more play stations. Tell us about the crowd and
        venue, and we’ll build the right high-capacity mix.
      </p>
      <a class="button button-accent" href="#availability-form">Tell us about the event</a>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
