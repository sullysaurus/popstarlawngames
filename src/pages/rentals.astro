---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout
  title="Book Lawn Game Rentals in Raleigh | Popstar Lawn Games"
  description="Check dates, prices, and availability for cornhole, giant tower, four-in-a-row, Putterball, ring toss, and yard dice rentals across Raleigh and the Triangle."
>
  <SiteHeader />

  <main>
    <section class="rental-hero">
      <div>
        <p class="eyebrow">Book individual games online</p>
        <h1>Pick a date.<br /><em>Bring the play.</em></h1>
      </div>
      <div class="rental-hero-copy">
        <p>
          Choose your event dates to see live availability and reserve individual games. Planning
          a wedding, company event, or a larger styled setup? Our concierge packages may be the
          better fit.
        </p>
        <a class="text-link" href="/#availability">Ask us to build your package <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="booking-shell" aria-labelledby="booking-title">
      <div class="booking-intro">
        <p class="eyebrow">Live inventory</p>
        <h2 id="booking-title">Check your date.</h2>
        <p>Select your rental period first. Prices and availability update automatically.</p>
      </div>

      <div class="booqable-date-wrap">
        <div class="booqable-datepicker"></div>
      </div>

      <div class="booqable-catalog">
        <div class="booqable-product-list"></div>
      </div>

      <aside class="booking-note">
        <strong>A quick heads-up:</strong>
        <span>
          Online reservations cover the games themselves. We’ll personally confirm your delivery,
          setup, pickup window, and any location-based fee before final payment.
        </span>
      </aside>
    </section>

    <section class="rental-concierge">
      <div>
        <p class="eyebrow">Want the whole lawn handled?</p>
        <h2>Packages start at $299.</h2>
      </div>
      <p>
        Tell us about the crowd and venue. We’ll recommend the right mix, coordinate delivery, and
        make the setup look intentional.
      </p>
      <a class="button button-accent" href="/#availability">Request a tailored package</a>
    </section>
  </main>

  <SiteFooter />
  <script is:inline src="https://4f058e46-ebd1-45b7-90bb-12c7cb19e4d4.assets.booqable.com/v2/booqable.js"></script>
</BaseLayout>
