---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

{!compact && (
  <div class="announcement">
    <p>Now booking the Triangle</p>
    <a href="/#availability">Request your date <span aria-hidden="true">↗</span></a>
  </div>
)}
<header class="site-header">
  <a class="brand" href="/" aria-label="Popstar Lawn Games home">
    <span class="brand-mark" aria-hidden="true"><img src="/assets/popstar-mark.png" alt="" /></span>
    <span>Popstar<br />Lawn Games</span>
  </a>
  <nav aria-label="Primary navigation">
    <a href="/#packages">Packages</a>
    <a href="/rentals/">Book games</a>
    <a href="/#occasions">Occasions</a>
    <a href="/blog/">Playbook</a>
  </nav>
  <a class="button button-small button-dark" href="/rentals/">Check availability</a>
</header>
